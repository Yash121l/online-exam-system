generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("draft")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sections    Json?
  scheduling  Json?
  randomizeQuestions Boolean @default(false)
  randomizeOptions   Boolean @default(false)

  sectionMeta ExamSection[]

  questions Question[]
  sessions  ExamSession[]
  pdfImports PdfImport[]
}

model ExamSection {
  id            String   @id @default(uuid())
  examId        String
  title         String
  timerSeconds  Int?
  navigation    Json?
  tools         Json?
  ordering      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  exam          Exam     @relation(fields: [examId], references: [id])
}

model ProctoringEvent {
  id            String   @id @default(uuid())
  examSessionId String?
  eventType     String
  payload       Json?
  createdAt     DateTime @default(now())

  session ExamSession? @relation(fields: [examSessionId], references: [id])
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  displayName    String
  role           Role
  passwordHash   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       ExamSession[]
  RequestLog     RequestLog[]
  SocketEventLog SocketEventLog[]
}

model ExamSession {
  id            String            @id @default(uuid())
  examId        String
  candidateId   String?
  candidateName String
  status        SessionStatus     @default(PENDING)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  exam          Exam              @relation(fields: [examId], references: [id])
  user          User?             @relation(fields: [candidateId], references: [id])
  proctoring    ProctoringEvent[]
  attempts      ExamAttempt[]
}

model Question {
  id        String       @id @default(uuid())
  examId    String
  prompt    String
  type      QuestionType
  options   Json?
  answerKey Json?
  points    Int          @default(1)
  mediaKey  String?
  bankItemId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  exam      Exam         @relation(fields: [examId], references: [id])
  bankItem  QuestionBankItem? @relation(fields: [bankItemId], references: [id])
}

model QuestionBankItem {
  id           String             @id @default(uuid())
  prompt       String
  type         QuestionType
  options      Json?
  answerKey    Json?
  mediaKey     String?
  format       QuestionTemplateType
  topics       Json?
  difficulty   String?
  tags         Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  questions    Question[]
}

model PdfImport {
  id        String   @id @default(uuid())
  examId    String
  pdfKey    String
  regions   Json?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam      Exam     @relation(fields: [examId], references: [id])
}

model RequestLog {
  id         String   @id @default(uuid())
  method     String
  path       String
  statusCode Int
  durationMs Int
  userId     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

model SocketEventLog {
  id        String   @id @default(uuid())
  eventType String
  socketId  String?
  userId    String?
  payload   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model ExamAttempt {
  id            String        @id @default(uuid())
  examSessionId String
  score         Float?
  status        AttemptStatus @default(NOT_STARTED)
  startedAt     DateTime?
  submittedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  session       ExamSession   @relation(fields: [examSessionId], references: [id])
}

enum Role {
  ADMIN
  TEACHER
  EVALUATOR
  STUDENT
}

enum QuestionType {
  MCQ
  ESSAY
  CODE
  DIAGRAM
  UPLOAD
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
  FILL_BLANK
  MATCHING
  ORDERING
  NUMERIC_RANGE
  MATRIX_RATING
  LIKERT
  HOTSPOT
  DRAG_DROP
  CLOZE
  TABLE_COMPLETION
  GRAPH_SKETCH
  CHART_LABELING
  COMPREHENSION
  CASE_STUDY
  SIMULATION
  AUDIO_RESPONSE
  VIDEO_RESPONSE
}

enum QuestionTemplateType {
  MCQ
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  ESSAY
  CODE
  DIAGRAM
  UPLOAD
  AUDIO_RESPONSE
  VIDEO_RESPONSE
  FILL_BLANK
  MATCHING
  ORDERING
  NUMERIC_RANGE
  MATRIX_RATING
  LIKERT
  SHORT_ANSWER
  LONG_ANSWER
  HOTSPOT
  DRAG_DROP
  CLOZE
  TABLE_COMPLETION
  GRAPH_SKETCH
  CHART_LABELING
  COMPREHENSION
  CASE_STUDY
  SIMULATION
}

enum SessionStatus {
  PENDING
  ACTIVE
  SUBMITTED
  REVIEW
  GRADED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

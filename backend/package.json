{
  "name": "@aegisexam/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for AegisExam providing APIs, WebSockets, and proctoring ingestion.",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
